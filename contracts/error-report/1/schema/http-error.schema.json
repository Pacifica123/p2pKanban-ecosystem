{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error-report/1/schema/http-error.schema.json",
  "title": "Тело ответа web-узла с ошибкой",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "message": {
          "type": "string"
        },
        "errorId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "UUID v7; обязателен для статуса ≥ 500, который выдал сам узел; та же строка в журнале узла (поле error_id) и в заголовке x-p2p-error-id"
        }
      }
    }
  }
}
