    },
    {
      "name": "file-url",
      "exitCode": 0,
      "stdout": "{\"schema\": \"p2p-kanban-launcher-status/1\", \"component\": \"sample\", \"installed\": true, \"running\": true, \"version\": \"2.1.0\", \"revision\": \"9db706cb0abf0000000000000000000000000000\", \"url\": \"file:///etc/passwd\", \"values\": {\"port\": 8080, \"listen\": \"local\"}, \"detail\": \"узел отвечает\", \"problems\": []}",
      "expected": {
        "protocol": "p2p-kanban-launcher-status/1",
        "state": "broken",
        "reason": "bad-output",
        "version": null,
