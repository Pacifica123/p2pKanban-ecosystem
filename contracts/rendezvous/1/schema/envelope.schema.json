{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rendezvous/1/schema/envelope.schema.json",
  "title": "Событие почтового ящика встречи (kind 1991) и его content",
  "allOf": [
    {
      "$ref": "../../../common/defs.schema.json#/$defs/nostrEvent"
    }
  ],
  "properties": {
    "kind": {
      "const": 1991
    },
    "tags": {
      "type": "array",
      "minItems": 4
    }
  },
  "$defs": {
    "content": {
      "type": "object",
      "required": [
        "version",
        "nonce",
        "ciphertext"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "nonce": {
          "$ref": "../../../common/defs.schema.json#/$defs/b64url24"
        },
        "ciphertext": {
          "$ref": "../../../common/defs.schema.json#/$defs/b64url"
        }
      }
    }
  }
}
