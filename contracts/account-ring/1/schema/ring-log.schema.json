{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "account-ring/1/schema/ring-log.schema.json",
  "title": "Открытое содержимое записи ring-log",
  "type": "object",
  "required": [
    "protocol",
    "accountId",
    "entries"
  ],
  "properties": {
    "protocol": {
      "const": "p2p-kanban-account-ring/1"
    },
    "accountId": {
      "$ref": "../../../common/defs.schema.json#/$defs/hex64"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "entry.schema.json"
      }
    }
  }
}
