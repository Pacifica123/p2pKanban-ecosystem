# Rust / Tauri generated output
/target/
/src-tauri/target/
/src-tauri/gen/

# Frontend dependencies and generated bundles
/node_modules/
/dist/
/coverage/
*.tsbuildinfo

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Native runtime/profile data must never be committed
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
/runtime/
/.local-state/

# Python/tooling cache
__pycache__/
*.py[cod]
.pytest_cache/

# Editor/OS noise
.DS_Store
.idea/
.vscode/

# UserTestSpace verification output
/.uts-reports/

# Arch packaging/release outputs (A15)
/packaging/arch/*.pkg.tar.zst
/packaging/arch/*.pkg.tar.zst.sig
/packaging/arch/p2pkanban-*.tar.gz
/packaging/arch/*.db
/packaging/arch/*.db.*
/packaging/arch/*.files
/packaging/arch/*.files.*
/packaging/arch/.SRCINFO
/release-stage/
