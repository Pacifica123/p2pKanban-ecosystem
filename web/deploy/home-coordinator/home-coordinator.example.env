# Copy to a private runtime file outside Git and replace every generated value.
# Generate strong values, for example:
#   openssl rand -base64 48

POSTGRES_PASSWORD=replace-with-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=https://your-static-client.example
PUBLIC_SIGNUP_ENABLED=false

TAILSCALE_HOSTNAME=p2p-kanban-home
# Optional reusable/ephemeral auth key. Leave empty and run `tailscale up`
# interactively if you do not want the key in a local env file.
TAILSCALE_AUTHKEY=
TAILSCALE_EXTRA_ARGS=--accept-dns=true

# Optional shadow mirror. Keep disabled until all private values below have
# been replaced and the relay-only recovery procedure has been read.
NOSTR_SHADOW_ENABLED=false
NOSTR_RELAYS=wss://relay-one.example,wss://relay-two.example,wss://relay-three.example
NOSTR_SECRET_KEY=replace-with-hex-or-nsec-key
NOSTR_MASTER_KEY_BASE64=replace-with-32-random-bytes-in-standard-base64
NOSTR_MIN_RELAY_ACKS=3
NOSTR_BACKFILL_ON_START=false
