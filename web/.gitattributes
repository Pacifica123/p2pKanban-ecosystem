* text=auto

# Container entrypoints must remain POSIX even when the checkout lives on Windows.
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.rs text eol=lf
*.Dockerfile text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Native Windows launchers keep their platform line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
